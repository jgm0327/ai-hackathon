# LLM
# provider: anthropic(기본, 배포용) | ollama(로컬 무료 검증용 폴백 — API 키 없을 때)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# 매일 쓰는 "메모 한 줄 정리"(parse_note()) 전용 — 경력기술서 생성(LLM_MODEL)보다
# 훨씬 가벼운 구조화 추출 작업이라 더 빠른 모델을 쓴다 (9/15, 발표 데모 속도 개선)
LLM_MODEL_FAST=claude-haiku-4-5-20251001
# LLM_PROVIDER=ollama 일 때만 사용 (ollama serve 로컬 실행 필요)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=exaone3.5:2.4b

# 임베딩 provider: chroma_default(기본, 배포용, 한국어 품질 낮음 — 실측 결과는
# tasks/track-b-agent-pipeline.md 참고) | ollama(로컬 전용, bge-m3로 한국어 품질 우수) |
# local_multilingual(서버 불필요, sentence-transformers 다국어 모델을 in-process로 로드 —
# `pip install sentence-transformers` 별도 필요, chroma_default보다 한국어 품질 우수하나 무거움)
EMBEDDING_PROVIDER=chroma_default
OLLAMA_EMBEDDING_MODEL=bge-m3
LOCAL_MULTILINGUAL_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Notion (REST API 우선)
NOTION_TOKEN=
# Notion MCP (선택, 9/14 구현됨 — 설정하면 POST /api/notion/sync가 이 경로를 먼저
# 시도하고 실패 시 REST로 폴백함. 실제 MCP 서버로 검증은 안 됐음, notion_client.py 참고)
NOTION_MCP_SERVER_URL=

# 사람인 오픈API (oapi.saramin.co.kr) — 키 승인 대기 중, 승인되면 채워 넣을 것
SARAMIN_API_KEY=

# Vector DB
CHROMA_PERSIST_DIR=./.chroma
MOCK_JD_DIR=data/mock_jds

# 태그 캐노니컬라이제이션 — "성능최적화"/"시스템최적화" 같은 동의어 태그를
# 임베딩 유사도로 통일할 때 쓰는 코사인 거리 기준값. 낮을수록 엄격(확실히 같을 때만 합침).
TAG_CANONICALIZE_THRESHOLD=0.15

# 카드/프로젝트 영속 저장 (SQLite)
DB_PATH=data/app.db

# 기록 첨부 사진 (9/18 신규, Figma "03 · 커리어 스택" 4.1-b).
# 이미지는 DB가 아니라 이 디렉터리에 파일로 저장된다 — SQLite에 BLOB으로 넣으면
# 백업 내보내기가 사진까지 통째로 메모리에 올려서 OCI AMD Micro(RAM 1GB)에 부담이다.
# 배포 시 이 경로가 재시작해도 남는 디스크인지 확인할 것(DB_PATH와 같은 볼륨이면 OK).
PHOTO_DIR=data/photos
# 사진 1장 최대 바이트(기본 8MB)와 기록 1건당 최대 장수.
PHOTO_MAX_BYTES=8388608
PHOTO_MAX_PER_CARD=10

# FastAPI CORS 허용 origin. 콤마로 구분. 9/14 카카오 로그인 도입으로 쿠키 세션을
# 쓰면서 "*"는 쓸 수 없게 됐다(자격증명 포함 요청엔 브라우저가 와일드카드를 거부함) —
# 로컬 개발 기본값은 프론트 dev 서버 origin. 배포 시엔 실제 프론트 origin으로 바꿀 것.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# 카카오 소셜 로그인 (9/14 신규) — developers.kakao.com 앱 설정에서 값을 그대로 복사.
# REST API 키(요약 정보), Redirect URI(제품 설정 → 카카오 로그인에 등록한 값과 정확히
# 일치해야 함), Client Secret(보안 탭에서 "사용함"으로 켰을 때만 필요).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
# 카카오 콜백 처리 후 브라우저를 돌려보낼 프론트엔드 주소.
FRONTEND_BASE_URL=http://localhost:3001
# 세션 쿠키 Secure 속성. 배포(HTTPS)는 true, 로컬 개발(http)은 반드시 false로 바꿀 것 —
# true인 채로 http에서 서빙하면 브라우저가 쿠키를 아예 저장하지 않는다.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Tier 2 푸시 알림 (선택, Track E)
# 키 생성: 아래 두 값을 raw base64url(URL-safe, 패딩 없음)로 함께 발급해야 함 —
# `python -m py_vapid --gen`은 PEM만 만들어서 PUBLIC_KEY(브라우저 applicationServerKey용)를
# 못 얻으므로, 대신 py_vapid.Vapid로 직접 생성할 것 (docs/04-push-notifications.md 참고).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=mailto:example@example.com

# 구독 데이터 저장소 (Tier 2 필수) — upstash.com에서 Redis DB(무료 티어) 생성 후
# DB 상세 페이지의 REST API 섹션에서 두 값 확인. 비어있으면 로컬 JSON 파일로 폴백함.
# 절대 커밋하지 말 것 — .env는 .gitignore 처리되어 있음.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 앱 기준 시간대 (9/17 신규). 유저가 입력하는 퇴근 시각과 카드의 "오늘"이 전부 이
# 시간대로 해석된다. **배포 시 반드시 확인할 것** — 서버 로컬 시간에 의존하던 이전
# 구현은 UTC 환경(GitHub Actions 러너, OCI VM 기본값)에서 9시간 어긋나 동작했다.
# 기본값이 Asia/Seoul이라 보통은 그대로 두면 된다.
APP_TIMEZONE=Asia/Seoul
